[Unit]
Description=Telegram Price Tracker Bot (ClipSnag)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/tgfinderbot
EnvironmentFile=/opt/tgfinderbot/.env
Environment="PYTHONUNBUFFERED=1"
Environment="MPLCONFIGDIR=/tmp/matplotlib"
ExecStart=/opt/tgfinderbot/.venv/bin/python /opt/tgfinderbot/main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
