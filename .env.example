# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Database URL (SQLite for lightweight VM or PostgreSQL for Docker)
DATABASE_URL=sqlite+aiosqlite:///./local_dev.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/price_tracker

# Affiliate / CPA Config (SalesDoubler / Admitad)
AFFILIATE_SUBID_KEY=tg_price_tracker_01
# Optional: if using redirect deeplink wrapper, e.g. https://rdr.salesdoubler.com.ua/in/offer/1234/
AFFILIATE_DEEPLINK_BASE=

# Limits & Monetization
FREE_MAX_PRODUCTS=3
PRO_MAX_PRODUCTS=20
PRO_PRICE_STARS=40
PRO_DURATION_DAYS=30

# Background Check Intervals (Free: 24h, PRO: 720m = 12h)
FREE_CHECK_INTERVAL_HOURS=24
PRO_CHECK_INTERVAL_MINUTES=720

# Scraper Config
SCRAPER_TIMEOUT_SECONDS=15.0
SCRAPER_MAX_RETRIES=3
SCRAPER_CONCURRENCY_LIMIT=5
